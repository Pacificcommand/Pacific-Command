static func lon_fix(lon: float) -> float:
	return lon if lon > 0.0 else lon + 360.0


## Is this map point on land (coastline polygons or island dots)?
static func on_land(lon: float, lat: float) -> bool:
	for nm in LAND:
		var poly: Array = LAND[nm]
		if _in_poly(lon, lat, poly):
			return true
	for d in DOTS:
		var dl: float = lon_fix(d[0])
		if War.dist_nm(lon, lat, dl, d[1]) < d[2]:
			return true
	return false


static func _in_poly(lon: float, lat: float, poly: Array) -> bool:
	var inside := false
	var n := poly.size()
	var j := n - 1
	for i in n:
		var xi: float = lon_fix(poly[i][0]); var yi: float = poly[i][1]
		var xj: float = lon_fix(poly[j][0]); var yj: float = poly[j][1]
		if ((yi > lat) != (yj > lat)) and (lon < (xj - xi) * (lat - yi) / (yj - yi) + xi):
			inside = not inside
		j = i
	return inside


## Does the straight track between two points cross land? Sampled every ~15 nm.
static func track_blocked(lon1: float, lat1: float, lon2: float, lat2: float) -> bool:
	var d := War.dist_nm(lon1, lat1, lon2, lat2)
	var n := maxi(1, int(d / 15.0))
	for i in range(1, n):
		var k := float(i) / n
		if on_land(lon1 + (lon2 - lon1) * k, lat1 + (lat2 - lat1) * k):
			return true
	return false
