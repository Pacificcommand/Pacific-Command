; Pacific Command - Godot 4.7 project file.
; Open this folder in Godot (Import > select this file) to load the project.

config_version=5

[application]

config/name="Pacific Command"
config/description="WWII Pacific naval combat. Combat sandbox build."
config/version="0.9.0"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="disabled"
window/vsync/vsync_mode=1

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.02, 0.06, 0.08, 1)
